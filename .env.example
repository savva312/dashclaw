# Copy to .env in the repo root and adjust values.
# .env.local overrides .env (gitignored).
# Keep both files owner-only: chmod 600 .env .env.local

DASHCLAW_PORT=8090
DASHCLAW_BIND=127.0.0.1
# Server-only credential (minimum 32 non-whitespace characters when configured).
# Required for non-loopback DASHCLAW_BIND. Never copy it to a VITE_* variable.
# DASHCLAW_TOKEN=replace-with-a-unique-random-token
# Use a dedicated, owner-only directory for custom database paths.
# DASHCLAW_DB=./data/dashclaw.db
# DASHCLAW_READ_ONLY=1

OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=
# Password fallback used only when OPENCLAW_GATEWAY_TOKEN is unset.
# OPENCLAW_GATEWAY_PASSWORD=
# OPENCLAW_GATEWAY_ALLOW_INSECURE=1 # Unsafe: permits remote plaintext ws:// on trusted networks only

# Use in-process fake gateway when OpenClaw is not running
# DASHCLAW_FAKE_GATEWAY=1

# Production UI (served from Hono when apps/web/dist exists)
# DASHCLAW_SERVE_WEB=0
# DASHCLAW_WEB_DIST=./apps/web/dist

# Web dev (Vite reads these from repo root)
# VITE_PORT=5173
# VITE_DASHCLAW_API_URL=http://127.0.0.1:8090
# Enter DASHCLAW_TOKEN in the browser login screen; it is kept in sessionStorage.
