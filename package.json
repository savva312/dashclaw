{
  "name": "dashclaw",
  "private": true,
  "version": "0.1.0",
  "description": "Agent OS runtime cockpit for OpenClaw",
  "license": "MIT",
  "author": "Christos Savva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savva312/dashclaw.git"
  },
  "bugs": {
    "url": "https://github.com/savva312/dashclaw/issues"
  },
  "homepage": "https://github.com/savva312/dashclaw#readme",
  "scripts": {
    "dev": "pnpm --parallel --filter @dashclaw/server --filter @dashclaw/web dev",
    "build": "pnpm -r build",
    "start": "pnpm build && pnpm --filter @dashclaw/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
